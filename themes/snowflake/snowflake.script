Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

longest_side = Window.GetWidth();
shortest_side = Window.GetWidth();
if (Window.GetHeight() > longest_side)
  longest_side = Window.GetHeight();
if (Window.GetHeight() < shortest_side)
  shortest_side = Window.GetHeight();

progress.width = Math.Int(Window.GetWidth() * 0.112);
progress.height = Math.Int(shortest_side * 0.003);
if (progress.height < 3) progress.height = 3;
progress.cap_width = Math.Int(progress.height / 2);

logo.source = Image("logo.png");
glow.source = Image("glow.png");
logo.image = logo.source;
glow.image = glow.source;
if (@SCALE_LOGO@)
{
  scaled_height = Math.Int(longest_side * 0.05);
  scaled_width = Math.Int(logo.source.GetWidth() * scaled_height / logo.source.GetHeight());
  logo.image = logo.source.Scale(scaled_width, scaled_height);
  glow.image = glow.source.Scale(
    Math.Int(glow.source.GetWidth() * scaled_height / logo.source.GetHeight()),
    Math.Int(glow.source.GetHeight() * scaled_height / logo.source.GetHeight())
  );
}
logo.width = logo.image.GetWidth();
logo.height = logo.image.GetHeight();

glow.sprite = Sprite(glow.image);
logo.sprite = Sprite(logo.image);

logo.x = Window.GetX() + (Window.GetWidth() - logo.width) / 2;
logo.y = (Window.GetHeight() - logo.height) / 2;
max_logo_y = Window.GetHeight() - 2 * logo.height - progress.height;
if (logo.y > max_logo_y) logo.y = max_logo_y;
if (logo.y < 0) logo.y = 0;
logo.y += Window.GetY();

glow.sprite.SetPosition(
  logo.x + (logo.width - glow.image.GetWidth()) * 0.5,
  logo.y + (logo.height - glow.image.GetHeight()) * 0.5,
  0
);
logo.sprite.SetPosition(logo.x, logo.y, 1);

progress.x = Window.GetX() + (Window.GetWidth() - progress.width) / 2;
progress.y = logo.y + 2 * logo.height;
progress.trough_left = Sprite(Image("progress-trough-left.png").Scale(progress.cap_width, progress.height));
progress.trough_center = Sprite(Image("progress-trough-center.png").Scale(progress.width - 2 * progress.cap_width, progress.height));
progress.trough_right = Sprite(Image("progress-trough-right.png").Scale(progress.cap_width, progress.height));
progress.trough_left.SetPosition(progress.x, progress.y, 2);
progress.trough_center.SetPosition(progress.x + progress.cap_width, progress.y, 2);
progress.trough_right.SetPosition(progress.x + progress.width - progress.cap_width, progress.y, 2);

progress.fill_left = Sprite(Image("progress-fill-left.png").Scale(progress.cap_width, progress.height));
progress.fill_center_image = Image("progress-fill-center.png");
progress.fill_short_image = Image("progress-fill-short.png");
progress.fill_center = Sprite();
progress.fill_right = Sprite(Image("progress-fill-right.png").Scale(progress.cap_width, progress.height));
progress.fill_left.SetPosition(progress.x, progress.y, 3);
progress.fill_center.SetPosition(progress.x + progress.cap_width, progress.y, 3);
progress.fill_right.SetPosition(progress.x + progress.cap_width, progress.y, 3);
progress.fill_left.SetOpacity(0);
progress.fill_center.SetOpacity(0);
progress.fill_right.SetOpacity(0);
progress.shown_width = 0;

mode = Plymouth.GetMode();
progress.is_update = mode == "updates" || mode == "system-upgrade" || mode == "firmware-upgrade";
progress.visible = mode == "boot" || progress.is_update;
progress.trough_left.SetOpacity(progress.visible);
progress.trough_center.SetOpacity(progress.visible);
progress.trough_right.SetOpacity(progress.visible);

fun show_progress(fraction)
{
  if (fraction < 0) fraction = 0;
  if (fraction > 1) fraction = 1;

  width = Math.Int(progress.width * fraction);
  if (width == 0)
  {
    progress.fill_left.SetOpacity(0);
    progress.fill_center.SetOpacity(0);
    progress.fill_right.SetOpacity(0);
  }
  else if (width <= 2 * progress.cap_width)
  {
    if (width != progress.shown_width)
      progress.fill_center.SetImage(progress.fill_short_image.Scale(width, progress.height));
    progress.fill_center.SetPosition(progress.x, progress.y, 3);
    progress.fill_left.SetOpacity(0);
    progress.fill_center.SetOpacity(progress.visible);
    progress.fill_right.SetOpacity(0);
  }
  else
  {
    if (width != progress.shown_width)
      progress.fill_center.SetImage(progress.fill_center_image.Scale(width - 2 * progress.cap_width, progress.height));
    progress.fill_center.SetPosition(progress.x + progress.cap_width, progress.y, 3);
    progress.fill_right.SetPosition(progress.x + width - progress.cap_width, progress.y, 3);
    progress.fill_left.SetOpacity(progress.visible);
    progress.fill_center.SetOpacity(progress.visible);
    progress.fill_right.SetOpacity(progress.visible);
  }
  progress.shown_width = width;
}

fun boot_progress_callback(duration, fraction)
{
  if (!progress.is_update) show_progress(fraction);
}

fun system_update_callback(percent)
{
  if (progress.is_update) show_progress(percent / 100);
}

Plymouth.SetBootProgressFunction(boot_progress_callback);
Plymouth.SetSystemUpdateFunction(system_update_callback);

angle = 0;
fun refresh_callback()
{
  angle += 0.0628;
  opacity = (Math.Cos(angle) + 1) / 2;
  glow.sprite.SetOpacity(opacity);
}

Plymouth.SetRefreshFunction(refresh_callback);
